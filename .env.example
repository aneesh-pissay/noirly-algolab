# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3003
AUTH_URL=http://localhost:3003
# 32+ bytes of random data: `openssl rand -base64 48`. Production refuses to
# start with a short, low-entropy or placeholder value.
AUTH_SECRET=replace-with-at-least-32-chars-of-random-data
AUTH_TRUST_HOST=true

# --- Database --------------------------------------------------------------
# The database keeps its original name.
MONGODB_URI=mongodb://127.0.0.1:27017/noirly-codelab

# --- Noirly Identity (OIDC) ------------------------------------------------
# Register a confidential client `noirly-algolab` in Identity's admin UI
# (/clients) with redirect URIs
#   http://localhost:3003/api/auth/callback/noirly
#   https://<production host>/api/auth/callback/noirly
# Must be HTTPS in production.
AUTH_NOIRLY_ISSUER=http://localhost:3000
AUTH_NOIRLY_CLIENT_ID=noirly-algolab
AUTH_NOIRLY_CLIENT_SECRET=
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3000

# Header your host sets to the real client IP (used for API rate limits).
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# --- Packages --------------------------------------------------------------
# Needed to install @noirly-dev/ui from GitHub Packages (local + Vercel build).
# A token with read:packages.
GITHUB_TOKEN=

# --- Mobile deep links (optional) -----------------------------------------
# IOS_APP_BUNDLE_ID=
# APPLE_TEAM_ID=
# ANDROID_APP_PACKAGE=
# ANDROID_APP_SHA256_FINGERPRINTS=
